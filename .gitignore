# SNU Submit — keep private and runtime material out of Git.
# Public source, tests, docs, schemas and manifests are text files and are not
# matched below. Review `git status` before every commit.

# --- Runs, snapshots and reports (private, per user) ---
# Written by Install-SnuSubmit.ps1 with the local venv path.
plugins/snu-submit/skills/snu-submit/runtime.json
.snu-submit/
**/.snu-submit/
/runs/
/snapshots/
/sources/
/reports/
/out/
/output/
/sample-output/
/samples-out/

# --- Submission working folders and private local material ---
/submissions/
/submission/
/private/
/local/
*.private.*

# Real submission/source documents should never be committed. Demo fixtures
# are generated by code at run time into a user-chosen folder.
*.pdf
*.docx
*.doc
*.hwp
*.hwpx
*.pptx
*.xlsx
*.zip
*.7z
*.rar

# --- Mail and browser originals, runtime downloads ---
*.eml
*.mbox
*.msg
*.har
/downloads/
*.crdownload
*.part
*.download

# --- Credentials, sessions and browser profile data ---
.env
.env.*
*.pem
*.key
*.p12
*.pfx
credentials*.json
client_secret*.json
token*.json
*.cookies
cookies.txt
cookies.json
*.session
chrome-profile/
User Data/
Login Data
Cookies

# --- Python caches, virtual environments, build and test output ---
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
/build/
/dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/
/test-results/
*.log

# --- OS and editor noise ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~
*.tmp
